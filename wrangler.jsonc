{
  // sol.pizza — served by a Cloudflare Worker with static assets.
  // Deploy:  npx wrangler deploy        (after `npx wrangler login`)
  // Build first: python3 build/gen.py   (writes ./dist)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sol-pizza",
  // The Cloudflare account that serves sol.pizza ("Polarized Jar"). Pinned because
  // the same login also sees another account with an unused sol-pizza Worker.
  "account_id": "8c4ec4948dc4732b29398c10fcb2020b",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true },
  // Worker Previews: Workers Builds runs `npx wrangler preview` for every branch
  // that isn't main, and that command needs this block. Empty: the site has no
  // bindings, so a Preview needs no settings of its own. Production deploys
  // (`wrangler deploy`, on main) use only the settings above.
  "previews": {}
}
