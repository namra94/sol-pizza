{
  // sol.pizza — served by a Cloudflare Worker with static assets.
  // Deploy:  npm run deploy   (after `npx wrangler login`): builds the public site
  //          into ./dist (python3 build/gen.py --public), then runs wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sol-pizza",
  // The Cloudflare account that serves sol.pizza ("Polarized Jar"). Pinned because
  // the same login also sees another account with an unused sol-pizza Worker.
  "account_id": "8c4ec4948dc4732b29398c10fcb2020b",
  "compatibility_date": "2026-09-22",
  // The Worker's own code runs first (run_worker_first below) for the passwords on
  // /dough/ and /backoffice/, the dough log's API and the purchase requests', and the
  // site password on the main site while the secret SITE_PASSWORD is set
  // (README-DEPLOY.md, "The site password"). The addresses with a ! skip the Worker:
  // the careers pages, the old /careers address and the applicant privacy notice, in
  // both languages, and the files those pages load. They stay open with or without the
  // password, served as they are, with _headers and _redirects.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/*",
      "!/jobs", "!/jobs/*", "!/vi/jobs", "!/vi/jobs/*",
      "!/careers", "!/careers/*",
      "!/privacy", "!/privacy/*", "!/vi/privacy", "!/vi/privacy/*",
      "!/assets/*", "!/favicon.svg", "!/pixel.js", "!/og-jobs.png", "!/og-jobs-vi.png",
      "!/robots.txt", "!/sitemap.xml"
    ]
  },
  // Who a purchase request mentions in Slack's #supply: the Kitchen approver for
  // Kitchen requests, the Bar & FOH approver for Bar and FOH ones. Slack member ids,
  // not secrets. The secrets are never in this file: the kitchen's DOUGH_PASSWORD
  // (README-DEPLOY.md, "The kitchen"), and the back office's two, BACKOFFICE_PASSWORD
  // and SLACK_WEBHOOK_URL ("The back office: purchase requests").
  "vars": {
    "SLACK_APPROVER_KITCHEN": "U0BTWU0P2TH",
    "SLACK_APPROVER_BAR_FOH": "U0C1Q87Q7E0"
  },
  // The dough log, and the back office's tables beside it (its purchase requests,
  // the sign-in throttle), each made by the Worker on first use.
  "d1_databases": [
    {
      "binding": "DOUGH_DB",
      "database_name": "sol-dough",
      "database_id": "08e24c9b-74eb-4664-a2c5-f7ef3627ce45"
    }
  ],
  "observability": { "enabled": true },
  // Worker Previews: Workers Builds runs `npx wrangler preview` for every branch
  // that isn't main, and that command needs this block. Empty on purpose: a
  // Preview gets no database, no passwords and no vars, so its /dough/ and
  // /backoffice/ stay locked (they say so) and can't reach the real dough log or
  // Slack. Production deploys (`wrangler deploy`, on main) use only the settings above.
  "previews": {}
}
