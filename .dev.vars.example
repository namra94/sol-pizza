# Secrets for `npx wrangler dev` on your own machine. Copy this file to .dev.vars
# (git-ignored) to sign in to /dough/ and /backoffice/ locally. Local test values
# only: the real passwords are set with `npx wrangler secret put DOUGH_PASSWORD`
# and `npx wrangler secret put BACKOFFICE_PASSWORD` and are never written in the repo.
DOUGH_PASSWORD=local-dough-test
BACKOFFICE_PASSWORD=local-office-test
# The back office's dry run: purchase requests are kept in the local database but
# never posted to Slack (the page shows the message instead). Never set it on the
# real site. SLACK_WEBHOOK_URL stays out of this file: README-DEPLOY.md, "The back
# office: purchase requests".
BACKOFFICE_DRY_RUN=1
